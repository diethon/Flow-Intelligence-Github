NODE_ENV=development
PORT=3001
HOST=0.0.0.0

MONGODB_URI=mongodb://127.0.0.1:27017/flow-intelligence

GITHUB_WEBHOOK_SECRET=replace-with-a-webhook-secret
GITHUB_CLIENT_ID=replace-with-a-github-client-id
GITHUB_CLIENT_SECRET=replace-with-a-github-client-secret
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ENCRYPTION_SALT=replace-with-a-random-salt
CORS_ORIGIN=http://localhost:5173

# Use GEMINI_API_KEYS for automatic key rotation. GEMINI_API_KEY remains
# available as the single-key fallback and is used by some AI services.
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_API_KEYS=replace-with-key-1,replace-with-key-2
GEMINI_API_KEY_CHAT=replace-with-a-gemini-chat-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flow Intelligence <noreply@flowintelligence.com>
